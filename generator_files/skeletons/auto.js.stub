(function () {
    'use strict';

    const repeatableStates = new WeakMap();
    const enhancedSelectInstances = new WeakMap();
    const htmlEditorInstances = new WeakMap();
    const concreteSelectorInstances = new WeakMap();
    const colorPickerInstances = new WeakSet();

    // Field widgets
    function destroyColorPickers(root) {
        const jquery = globalThis.jQuery;
        if (typeof jquery !== 'function' || typeof jquery.fn?.spectrum !== 'function') {
            return;
        }

        root.querySelectorAll('[data-block-builder-color-picker]').forEach((field) => {
            if (!colorPickerInstances.has(field)) {
                return;
            }
            jquery(field).spectrum('destroy');
            colorPickerInstances.delete(field);
        });
    }

    function initializeColorPickers(root) {
        const jquery = globalThis.jQuery;
        root.querySelectorAll('[data-block-builder-color-picker]').forEach((field) => {
            if (!(field instanceof HTMLInputElement) || colorPickerInstances.has(field)) {
                return;
            }
            if (typeof jquery !== 'function' || typeof jquery.fn?.spectrum !== 'function') {
                console.error('Block Builder color fields require the Concrete CMS color picker asset.');
                return;
            }

            jquery(field).spectrum({
                allowEmpty: true,
                appendTo: '.ui-dialog',
                cancelText: field.dataset.cancelText ?? 'Cancel',
                chooseText: field.dataset.chooseText ?? 'Choose',
                className: 'ccm-widget-colorpicker',
                clearText: field.dataset.clearText ?? 'Clear Color Selection',
                noColorSelectedText: field.dataset.noColorSelectedText ?? 'No Color Selected',
                preferredFormat: 'hex',
                showAlpha: true,
                showInitial: true,
                showInput: true,
                showPalette: false,
                togglePaletteLessText: field.dataset.togglePaletteLessText ?? 'less',
                togglePaletteMoreText: field.dataset.togglePaletteMoreText ?? 'more',
                type: 'color',
                value: field.value,
            });
            colorPickerInstances.add(field);
        });
    }

    function updateCharacterCounter(field) {
        if (!(field instanceof HTMLInputElement || field instanceof HTMLTextAreaElement)) {
            return;
        }

        const counter = field.closest('.mb-4')?.querySelector('[data-block-builder-character-counter]');
        const currentCount = counter?.querySelector('[data-character-count-current]');
        if (currentCount) {
            currentCount.textContent = String(Array.from(field.value).length);
        }
    }

    function initializeCharacterCounters(root) {
        root.querySelectorAll('[data-block-builder-character-count]').forEach(updateCharacterCounter);
    }

    function updateSvgIconPreview(select) {
        if (!(select instanceof HTMLSelectElement)) {
            return;
        }

        const picker = select.closest('[data-block-builder-svg-icon-picker]');
        const previewContainer = picker?.querySelector('[data-svg-icon-preview-container]');
        const preview = previewContainer?.querySelector('[data-svg-icon-preview]');
        const previewSource = select.selectedOptions[0]?.dataset.svgIconPreview ?? '';

        if (!(preview instanceof HTMLImageElement)) {
            return;
        }

        if (previewSource === '') {
            preview.removeAttribute('src');
            preview.classList.add('invisible');
            return;
        }

        preview.src = previewSource;
        preview.classList.remove('invisible');
    }

    function initializeSvgIconPreviews(root) {
        root.querySelectorAll('[data-svg-icon-select]').forEach(updateSvgIconPreview);
    }

    function handleSvgIconChange(event) {
        if (event.target instanceof HTMLSelectElement && event.target.matches('[data-svg-icon-select]')) {
            updateSvgIconPreview(event.target);
        }
    }

    function handleCharacterCountInput(event) {
        if (event.target instanceof Element && event.target.matches('[data-block-builder-character-count]')) {
            updateCharacterCounter(event.target);
        }
    }

    function destroyConcreteSelectors(root) {
        root.querySelectorAll('[data-block-builder-concrete-selector]').forEach((container) => {
            const instance = concreteSelectorInstances.get(container);
            if (instance && typeof instance.$destroy === 'function') {
                instance.$destroy();
            }
            concreteSelectorInstances.delete(container);
        });
    }

    function initializeConcreteSelectors(root) {
        root.querySelectorAll('[data-block-builder-concrete-selector]').forEach((container) => {
            if (concreteSelectorInstances.has(container)) {
                return;
            }
            if (typeof globalThis.Concrete?.Vue?.activateContext !== 'function') {
                console.error('Block Builder selector fields require the Concrete CMS Vue context.');
                return;
            }

            globalThis.Concrete.Vue.activateContext('cms', (Vue, config) => {
                if (!container.isConnected || concreteSelectorInstances.has(container)) {
                    return;
                }

                concreteSelectorInstances.set(
                    container,
                    new Vue({
                        el: container,
                        components: config.components,
                    })
                );
            });
        });
    }

    function updateImageDimensionFields(toggle) {
        if (!(toggle instanceof HTMLInputElement)) {
            return;
        }

        const group = toggle.closest('[data-image-dimension-group]');
        const fields = group?.querySelector('[data-image-dimension-fields]');
        if (fields) {
            fields.hidden = !toggle.checked;
        }
    }

    function initializeImageDimensionFields(root) {
        root.querySelectorAll('[data-image-dimension-toggle]').forEach(updateImageDimensionFields);
    }

    function handleImageDimensionChange(event) {
        if (event.target instanceof HTMLInputElement && event.target.matches('[data-image-dimension-toggle]')) {
            updateImageDimensionFields(event.target);
        }
    }

    function updateImageAdditionalFields(toggle, expanded) {
        const container = toggle.parentElement?.nextElementSibling;
        const state = toggle.parentElement?.querySelector('[data-image-additional-state]');
        const label = toggle.querySelector('[data-image-additional-toggle-label]');
        toggle.setAttribute('aria-expanded', expanded ? 'true' : 'false');
        if (container?.matches('[data-image-additional-fields]')) {
            container.hidden = !expanded;
        }
        if (state instanceof HTMLInputElement) {
            state.value = expanded ? '1' : '0';
        }
        if (label) {
            label.textContent = expanded ? (toggle.dataset.hideLabel ?? '') : (toggle.dataset.showLabel ?? '');
        }
        toggle.querySelector('i')?.classList.toggle('fa-rotate-90', expanded);
    }

    function initializeImageAdditionalFields(root) {
        root.querySelectorAll('[data-image-additional-toggle]').forEach((toggle) => {
            const state = toggle.parentElement?.querySelector('[data-image-additional-state]');
            const expanded = state instanceof HTMLInputElement ? state.value === '1' : toggle.getAttribute('aria-expanded') === 'true';
            updateImageAdditionalFields(toggle, expanded);
        });
    }

    function handleImageAdditionalFieldsClick(event) {
        const toggle = event.target instanceof Element ? event.target.closest('[data-image-additional-toggle]') : null;
        if (!toggle) {
            return;
        }

        updateImageAdditionalFields(toggle, toggle.getAttribute('aria-expanded') !== 'true');
    }

    function destroyEnhancedSelects(root) {
        root.querySelectorAll('[data-block-builder-enhanced-select]').forEach((field) => {
            const enhancedSelect = enhancedSelectInstances.get(field) ?? field.tomselect;
            if (enhancedSelect && typeof enhancedSelect.destroy === 'function') {
                enhancedSelect.destroy();
            }
            enhancedSelectInstances.delete(field);
        });
    }

    function initializeEnhancedSelects(root) {
        root.querySelectorAll('[data-block-builder-enhanced-select]').forEach((field) => {
            if (!(field instanceof HTMLSelectElement) || enhancedSelectInstances.has(field)) {
                return;
            }
            if (typeof globalThis.TomSelect !== 'function') {
                console.error('Block Builder enhanced select fields require Tom Select.');
                return;
            }

            enhancedSelectInstances.set(
                field,
                new globalThis.TomSelect(field, {
                    create: false,
                })
            );
        });
    }

    function synchronizeHtmlEditor(field) {
        const editorState = htmlEditorInstances.get(field);
        if (editorState) {
            field.value = editorState.editor.getValue();
        }
    }

    function destroyHtmlEditors(root) {
        root.querySelectorAll('[data-block-builder-html-editor-input]').forEach((field) => {
            const editorState = htmlEditorInstances.get(field);
            if (!editorState) {
                return;
            }

            editorState.resizeObserver?.disconnect();
            editorState.editor.destroy();
            htmlEditorInstances.delete(field);
        });
    }

    function initializeHtmlEditors(root) {
        root.querySelectorAll('[data-block-builder-html-editor]').forEach((container) => {
            const inputIdentifier = container.dataset.htmlEditorInput;
            const input = inputIdentifier ? document.getElementById(inputIdentifier) : null;
            if (!(input instanceof HTMLTextAreaElement) || htmlEditorInstances.has(input)) {
                return;
            }
            if (typeof globalThis.ace?.edit !== 'function') {
                console.error('Block Builder HTML editors require the Concrete CMS Ace asset.');
                return;
            }

            const editor = globalThis.ace.edit(container);
            editor.setTheme('ace/theme/eclipse');
            editor.getSession().setMode('ace/mode/html');
            editor.setValue(input.value, -1);
            editor.getSession().on('change', () => {
                input.value = editor.getValue();
            });

            const resizeObserver = typeof ResizeObserver === 'function' ? new ResizeObserver(() => editor.resize()) : null;
            resizeObserver?.observe(container);
            htmlEditorInstances.set(input, { editor, resizeObserver });
        });
    }

    function getWysiwygEditorInstance(field) {
        if (!(field instanceof HTMLTextAreaElement) || !field.id) {
            return null;
        }

        return globalThis.CKEDITOR?.instances?.[field.id] ?? null;
    }

    function synchronizeWysiwygEditor(field) {
        const editor = getWysiwygEditorInstance(field);
        if (editor && typeof editor.updateElement === 'function') {
            editor.updateElement();
        }
    }

    function destroyWysiwygEditors(root) {
        root.querySelectorAll('[data-block-builder-wysiwyg]').forEach((field) => {
            const editor = getWysiwygEditorInstance(field);
            if (editor && typeof editor.destroy === 'function') {
                editor.destroy(true);
            }
            field.removeAttribute('data-wysiwyg-initialized');
        });
    }

    function initializeWysiwygEditors(root) {
        root.querySelectorAll('[data-block-builder-wysiwyg]').forEach((field) => {
            const existingEditor = getWysiwygEditorInstance(field);
            if (field.dataset.wysiwygInitialized === 'true' && existingEditor?.element?.$ === field) {
                return;
            }

            if (existingEditor) {
                existingEditor.destroy(true);
            }

            const formContainer = field.closest('[data-block-builder-form]');
            const initializer = formContainer?.blockBuilderWysiwygEditorInitializers?.[field.dataset.wysiwygHandle];
            if (typeof initializer !== 'function') {
                return;
            }

            try {
                initializer(field);
                field.dataset.wysiwygInitialized = 'true';
            } catch (error) {
                console.error('Block Builder could not initialize a WYSIWYG editor.', error);
            }
        });
    }

    // Repeatable field values
    function getRepeatableEntries(state) {
        return Array.from(state.entriesContainer.children).filter((element) => element.matches('[data-entry]'));
    }

    function groupEntryFields(entry) {
        const fields = new Map();

        entry.querySelectorAll('[data-entry-field]').forEach((field) => {
            const handle = field.dataset.entryField;
            if (!handle) {
                return;
            }

            const subfield = field.dataset.entrySubfield ?? '';
            const groupKey = `${handle}:${subfield}`;
            if (!fields.has(groupKey)) {
                fields.set(groupKey, { handle, subfield, fields: [] });
            }
            fields.get(groupKey).fields.push(field);
        });

        return fields;
    }

    function normalizeMultipleFieldValue(value) {
        if (Array.isArray(value)) {
            return value.map(String);
        }
        if (typeof value === 'string' && value.includes('|')) {
            return value.split('|');
        }
        if (value === null || value === undefined || value === '') {
            return [];
        }

        return [String(value)];
    }

    function setEntryFieldValue(fields, value) {
        const firstField = fields[0];
        if (!firstField) {
            return;
        }

        if (firstField.matches('[data-block-builder-concrete-selector]')) {
            const selectorType = firstField.dataset.blockBuilderConcreteSelector;
            const concreteSelectorConfiguration = {
                express: { element: 'concrete-express-entry-input', valueAttribute: 'entry-id' },
                file: { element: 'concrete-file-input', valueAttribute: ':file-id' },
                icon: { element: 'icon-selector', valueAttribute: 'selected' },
                page: { element: 'concrete-page-input', valueAttribute: ':page-id' },
                user: { element: 'concrete-user-input', valueAttribute: ':user-id' },
            }[selectorType];
            const selectedValue = String(value ?? (selectorType === 'icon' ? '' : '0'));
            firstField.dataset.selectedValue = selectedValue;
            if (concreteSelectorConfiguration) {
                firstField.querySelector(concreteSelectorConfiguration.element)?.setAttribute(concreteSelectorConfiguration.valueAttribute, selectedValue);
            }
            return;
        }

        if (firstField instanceof HTMLInputElement && firstField.type === 'radio') {
            fields.forEach((field) => {
                field.checked = String(field.value) === String(value ?? '');
            });
            return;
        }

        if (firstField instanceof HTMLInputElement && firstField.type === 'checkbox') {
            const selectedValues = normalizeMultipleFieldValue(value);
            fields.forEach((field) => {
                field.checked = fields.length === 1 && typeof value === 'boolean' ? value : selectedValues.includes(String(field.value));
            });
            return;
        }

        if (firstField instanceof HTMLSelectElement && firstField.multiple) {
            const selectedValues = normalizeMultipleFieldValue(value);
            Array.from(firstField.options).forEach((option) => {
                option.selected = selectedValues.includes(String(option.value));
            });
            return;
        }

        fields.forEach((field) => {
            if (!(field instanceof HTMLInputElement && field.type === 'file') && 'value' in field) {
                field.value = value ?? '';
            }
        });
    }

    function populateEntry(entry, values) {
        if (!values || typeof values !== 'object') {
            return;
        }

        groupEntryFields(entry).forEach((group) => {
            if (!Object.prototype.hasOwnProperty.call(values, group.handle)) {
                return;
            }

            const value = group.subfield ? values[group.handle]?.[group.subfield] : values[group.handle];
            if (!group.subfield || (values[group.handle] && typeof values[group.handle] === 'object')) {
                setEntryFieldValue(group.fields, value);
            }
        });
    }

    function readEntryFieldValue(fields) {
        const firstField = fields[0];
        if (!firstField) {
            return null;
        }

        synchronizeHtmlEditor(firstField);
        synchronizeWysiwygEditor(firstField);

        if (firstField.matches('[data-block-builder-concrete-selector]')) {
            const selectorType = firstField.dataset.blockBuilderConcreteSelector;
            const selectedControl = firstField.querySelector(selectorType === 'icon' ? 'select[name]' : 'input[type="hidden"][name]');

            return selectedControl?.value ?? firstField.dataset.selectedValue ?? (selectorType === 'icon' ? '' : '0');
        }

        if (firstField instanceof HTMLInputElement && firstField.type === 'radio') {
            return fields.find((field) => field.checked)?.value ?? '';
        }
        if (firstField instanceof HTMLInputElement && firstField.type === 'checkbox') {
            if (fields.length === 1) {
                return firstField.checked;
            }
            return fields.filter((field) => field.checked).map((field) => field.value);
        }
        if (firstField instanceof HTMLSelectElement && firstField.multiple) {
            return Array.from(firstField.selectedOptions).map((option) => option.value);
        }
        if (firstField instanceof HTMLInputElement && firstField.type === 'file') {
            return null;
        }

        return 'value' in firstField ? firstField.value : null;
    }

    function readEntry(entry) {
        const values = {};
        groupEntryFields(entry).forEach((group) => {
            const value = readEntryFieldValue(group.fields);
            if (group.subfield) {
                if (!values[group.handle] || typeof values[group.handle] !== 'object') {
                    values[group.handle] = {};
                }
                values[group.handle][group.subfield] = value;
            } else {
                values[group.handle] = value;
            }
        });

        return values;
    }

    // Link fields
    function updateLinkField(container) {
        const linkType = container.querySelector('[data-link-type]')?.value ?? '';
        const additionalValue = container.querySelector('[data-link-additional-value]');
        const showAdditionalFields = additionalValue?.value === '1';
        const toggle = container.querySelector('[data-link-toggle-additional]');

        container.querySelectorAll('[data-link-type-panel]').forEach((panel) => {
            panel.hidden = panel.dataset.linkTypePanel !== linkType;
        });
        if (toggle) {
            toggle.hidden = linkType === '';
            toggle.classList.toggle('active', showAdditionalFields);
            const label = toggle.querySelector('[data-link-toggle-label]');
            if (label) {
                label.textContent = showAdditionalFields ? toggle.dataset.hideLabel : toggle.dataset.showLabel;
            }
        }
        container.querySelectorAll('[data-link-additional-fields]').forEach((fields) => {
            fields.hidden = linkType === '' || !showAdditionalFields;
        });
    }

    function initializeLinkFields(root) {
        root.querySelectorAll('[data-block-builder-link]').forEach(updateLinkField);
    }

    function handleLinkClick(event) {
        if (!(event.target instanceof Element)) {
            return;
        }

        const toggle = event.target.closest('[data-link-toggle-additional]');
        const container = toggle?.closest('[data-block-builder-link]');
        const additionalValue = container?.querySelector('[data-link-additional-value]');
        if (!toggle || !container || !additionalValue) {
            return;
        }

        event.preventDefault();
        additionalValue.value = additionalValue.value === '1' ? '0' : '1';
        additionalValue.dispatchEvent(new Event('change', { bubbles: true }));
        updateLinkField(container);
    }

    function handleLinkChange(event) {
        if (!(event.target instanceof Element)) {
            return;
        }

        const container = event.target.closest('[data-block-builder-link]');
        if (container && event.target.matches('[data-link-type], [data-link-additional-value]')) {
            updateLinkField(container);
        }
    }

    function handleExternalLinkInput(event) {
        if (!(event.target instanceof HTMLInputElement) || !event.target.matches('[data-link-external-url]')) {
            return;
        }

        const protocol = event.target.closest('[data-block-builder-link]')?.querySelector('[data-link-protocol]');
        const protocolMatch = event.target.value.match(/^(https?:\/\/)/i);
        if (protocol instanceof HTMLSelectElement && protocolMatch) {
            protocol.value = protocolMatch[1].toLowerCase();
            event.target.value = event.target.value.slice(protocolMatch[1].length);
        }
    }

    // Shared widget lifecycle
    function initializeFieldWidgets(root) {
        initializeEnhancedSelects(root);
        initializeColorPickers(root);
        initializeCharacterCounters(root);
        initializeSvgIconPreviews(root);
        initializeHtmlEditors(root);
        initializeWysiwygEditors(root);
        initializeConcreteSelectors(root);
        initializeLinkFields(root);
        initializeImageDimensionFields(root);
        initializeImageAdditionalFields(root);
    }

    function destroyFieldWidgets(root) {
        destroyEnhancedSelects(root);
        destroyColorPickers(root);
        destroyHtmlEditors(root);
        destroyWysiwygEditors(root);
        destroyConcreteSelectors(root);
    }

    // Repeatable entry interface
    function getTitleSourceValue(source) {
        if (source instanceof HTMLSelectElement) {
            return Array.from(source.selectedOptions)
                .map((option) => (option.textContent ?? '').trim())
                .filter(Boolean)
                .join(', ');
        }
        if (source instanceof HTMLInputElement && ['checkbox', 'radio'].includes(source.type)) {
            return source.checked ? source.value : '';
        }

        return 'value' in source ? String(source.value).trim() : (source.textContent ?? '').trim();
    }

    function updateEntryTitle(entry, position) {
        const title = Array.from(entry.querySelectorAll('[data-entry-title-source]')).map(getTitleSourceValue).filter(Boolean).join(', ');
        const titleElement = entry.querySelector('[data-entry-title]');
        if (titleElement) {
            titleElement.textContent = title === '' ? `#${position}` : `${title} #${position}`;
        }
    }

    function setEntryExpanded(entry, expanded) {
        const content = entry.querySelector('[data-entry-content]');
        const button = entry.querySelector('[data-entry-action="toggle"]');
        if (!content || !button) {
            return;
        }

        content.hidden = !expanded;
        button.setAttribute('aria-expanded', String(expanded));
        button.setAttribute('aria-label', expanded ? button.dataset.collapseLabel : button.dataset.expandLabel);
        button.setAttribute('title', expanded ? button.dataset.collapseLabel : button.dataset.expandLabel);

        const icon = button.querySelector('i');
        if (icon) {
            icon.classList.toggle('fa-minus-square', expanded);
            icon.classList.toggle('fa-plus-square', !expanded);
        }
    }

    function updateRepeatableState(state) {
        const entries = getRepeatableEntries(state);
        const maxEntriesReached = entries.length >= state.maxEntries;
        const noEntries = entries.length === 0;

        state.repeatable.querySelectorAll('[data-entry-count]').forEach((counter) => {
            counter.textContent = String(entries.length);
        });
        state.repeatable.querySelectorAll('[data-no-entries-message]').forEach((message) => {
            message.hidden = !noEntries;
        });
        state.repeatable
            .querySelectorAll(
                '[data-entry-action="add-top"], [data-entry-action="add-bottom"], ' + '[data-entry-action="duplicate"], [data-entry-action="duplicate-at-end"]'
            )
            .forEach((button) => {
                button.disabled = maxEntriesReached;
            });
        state.repeatable.querySelectorAll('[data-entry-action="copy-last"]').forEach((button) => {
            button.disabled = noEntries || maxEntriesReached;
        });
        state.repeatable.querySelectorAll('[data-entry-action="remove-all"]').forEach((button) => {
            button.disabled = noEntries;
        });

        entries.forEach((entry, index) => {
            updateEntryTitle(entry, index + 1);
        });
    }

    function createEntry(state, values, beforeEntry = null) {
        if (getRepeatableEntries(state).length >= state.maxEntries) {
            return null;
        }

        const entryIndex = state.nextIndex;
        state.nextIndex += 1;

        const template = document.createElement('template');
        template.innerHTML = state.entryTemplate.innerHTML.split('__INDEX__').join(String(entryIndex)).trim();
        const entry = template.content.querySelector('[data-entry]');
        if (!entry) {
            console.error('Block Builder entry template is missing its data-entry element.');
            return null;
        }

        entry.dataset.entryIndex = String(entryIndex);
        populateEntry(entry, values);
        state.entriesContainer.insertBefore(template.content, beforeEntry);
        initializeFieldWidgets(entry);
        entry.dispatchEvent(new CustomEvent('blockbuilder:entry-added', { bubbles: true }));

        const keepCollapsed = state.repeatable.querySelector('[data-keep-added-collapsed]')?.checked === true;
        setEntryExpanded(entry, !keepCollapsed);
        updateRepeatableState(state);

        if (state.repeatable.querySelector('[data-disable-smooth-scroll]')?.checked !== true) {
            const dialogContent = entry.closest('.ui-dialog-content');

            if (dialogContent) {
                const scrollOffset = 10;
                const entryScrollTop = dialogContent.scrollTop + entry.getBoundingClientRect().top - dialogContent.getBoundingClientRect().top - scrollOffset;

                dialogContent.scrollTo({
                    top: entryScrollTop,
                    behavior: 'smooth',
                });
            }
        }

        return entry;
    }

    function removeEntryElement(entry) {
        entry.dispatchEvent(new CustomEvent('blockbuilder:entry-before-remove', { bubbles: true }));
        destroyFieldWidgets(entry);
        entry.remove();
    }

    function removeEntry(state, entry) {
        removeEntryElement(entry);
        updateRepeatableState(state);
    }

    function confirmEntryAction(button) {
        return !button.dataset.confirm || globalThis.confirm(button.dataset.confirm);
    }

    function getRepeatableState(element) {
        const repeatable = element.closest('[data-block-builder-repeatable]');
        const entriesContainer = repeatable?.querySelector('[data-block-builder-entries]');

        return entriesContainer ? repeatableStates.get(entriesContainer) : null;
    }

    function handleEntryActionClick(event) {
        if (!(event.target instanceof Element)) {
            return;
        }

        const button = event.target.closest('[data-entry-action]');
        const state = button ? getRepeatableState(button) : null;
        if (!button || !state || button.disabled) {
            return;
        }

        event.preventDefault();

        const action = button.dataset.entryAction;
        const entry = button.closest('[data-entry]');
        const entries = getRepeatableEntries(state);

        if (action === 'add-top') {
            createEntry(state, state.defaultValues, entries[0] ?? null);
        } else if (action === 'add-bottom') {
            createEntry(state, state.defaultValues);
        } else if (action === 'copy-last' && entries.length > 0) {
            createEntry(state, readEntry(entries.at(-1)));
        } else if (action === 'duplicate' && entry) {
            createEntry(state, readEntry(entry), entry.nextElementSibling);
        } else if (action === 'duplicate-at-end' && entry) {
            createEntry(state, readEntry(entry));
        } else if (action === 'remove' && entry && confirmEntryAction(button)) {
            removeEntry(state, entry);
        } else if (action === 'remove-all' && confirmEntryAction(button)) {
            entries.forEach(removeEntryElement);
            updateRepeatableState(state);
        } else if (action === 'toggle' && entry) {
            setEntryExpanded(entry, button.getAttribute('aria-expanded') !== 'true');
        } else if (action === 'expand-all') {
            entries.forEach((currentEntry) => setEntryExpanded(currentEntry, true));
        } else if (action === 'collapse-all') {
            entries.forEach((currentEntry) => setEntryExpanded(currentEntry, false));
        }
    }

    function handleEntryTitleChange(event) {
        if (!(event.target instanceof Element) || !event.target.matches('[data-entry-title-source]')) {
            return;
        }

        const entry = event.target.closest('[data-entry]');
        const state = entry ? getRepeatableState(entry) : null;
        if (state) {
            const position = getRepeatableEntries(state).indexOf(entry);
            if (position >= 0) {
                updateEntryTitle(entry, position + 1);
            }
        }
    }

    function initializeEntrySorting(state) {
        const jquery = globalThis.jQuery;
        if (typeof jquery !== 'function' || typeof jquery.fn?.sortable !== 'function') {
            console.error('Block Builder repeatable entries require jQuery UI Sortable.');
            return;
        }

        jquery(state.entriesContainer).sortable({
            axis: 'y',
            cancel: 'input, textarea, select, option',
            cursor: 'move',
            forcePlaceholderSize: true,
            handle: '[data-entry-drag-handle]',
            items: '> [data-entry]',
            placeholder: 'bb-entry-sort-placeholder',
            tolerance: 'pointer',
            start(_event, sortableData) {
                sortableData.item.addClass('bb-entry-dragging');
            },
            stop(_event, sortableData) {
                sortableData.item.removeClass('bb-entry-dragging');
                updateRepeatableState(state);
            },
        });
    }

    function handleEntryMoveKeydown(event) {
        if (!(event.target instanceof Element) || !event.target.matches('[data-entry-drag-handle]') || !['ArrowUp', 'ArrowDown'].includes(event.key)) {
            return;
        }

        const entry = event.target.closest('[data-entry]');
        const state = entry ? getRepeatableState(entry) : null;
        if (!entry || !state) {
            return;
        }

        const entries = getRepeatableEntries(state);
        const entryPosition = entries.indexOf(entry);
        if (event.key === 'ArrowUp' && entryPosition > 0) {
            event.preventDefault();
            state.entriesContainer.insertBefore(entry, entries[entryPosition - 1]);
        } else if (event.key === 'ArrowDown' && entryPosition < entries.length - 1) {
            event.preventDefault();
            state.entriesContainer.insertBefore(entries[entryPosition + 1], entry);
        } else {
            return;
        }

        updateRepeatableState(state);
        event.target.focus();
    }

    function parseRepeatableData(repeatable) {
        const dataElement = repeatable.querySelector('script[data-entry-data]');
        if (!dataElement) {
            return {};
        }

        try {
            return JSON.parse(dataElement.textContent || '{}');
        } catch (error) {
            console.error('Block Builder could not parse repeatable entry data.', error);
            return {};
        }
    }

    function initializeRepeatable(entriesContainer) {
        if (repeatableStates.has(entriesContainer)) {
            return;
        }

        const repeatable = entriesContainer.closest('[data-block-builder-repeatable]');
        const entryTemplate = repeatable?.querySelector('template[data-entry-template]');
        if (!repeatable || !entryTemplate) {
            return;
        }

        const repeatableData = parseRepeatableData(repeatable);
        const configuredMaxEntries = Number.parseInt(entriesContainer.dataset.maxEntries ?? repeatableData.maxEntries, 10);
        const usedIndexes = Array.from(entriesContainer.querySelectorAll(':scope > [data-entry]'))
            .map((entry) => Number.parseInt(entry.dataset.entryIndex, 10))
            .filter(Number.isInteger);
        const state = {
            entriesContainer,
            defaultValues: repeatableData.defaultValues && typeof repeatableData.defaultValues === 'object' ? repeatableData.defaultValues : {},
            maxEntries: Number.isInteger(configuredMaxEntries) && configuredMaxEntries > 0 ? configuredMaxEntries : Number.POSITIVE_INFINITY,
            nextIndex: usedIndexes.length > 0 ? Math.max(...usedIndexes) + 1 : 0,
            repeatable,
            entryTemplate,
        };
        repeatableStates.set(entriesContainer, state);

        const existingEntries = getRepeatableEntries(state);
        if (existingEntries.length === 0 && Array.isArray(repeatableData.entries)) {
            repeatableData.entries.forEach((values) => createEntry(state, values));
        }
        initializeEntrySorting(state);
        updateRepeatableState(state);
    }

    // Form initialization
    function handleSubmit(event) {
        if (!(event.target instanceof HTMLFormElement)) {
            return;
        }

        event.target.querySelectorAll('[data-block-builder-html-editor-input]').forEach(synchronizeHtmlEditor);
        event.target.querySelectorAll('[data-block-builder-wysiwyg]').forEach(synchronizeWysiwygEditor);
    }

    function initializeBlockBuilderForm(formContainer) {
        if (formContainer.dataset.blockBuilderInitialized === 'true') {
            return;
        }

        formContainer.querySelectorAll('[data-block-builder-entries]').forEach(initializeRepeatable);
        initializeFieldWidgets(formContainer);

        formContainer.addEventListener('click', handleEntryActionClick);
        formContainer.addEventListener('click', handleLinkClick);
        formContainer.addEventListener('click', handleImageAdditionalFieldsClick);
        formContainer.addEventListener('input', handleEntryTitleChange);
        formContainer.addEventListener('input', handleExternalLinkInput);
        formContainer.addEventListener('input', handleCharacterCountInput);
        formContainer.addEventListener('change', handleEntryTitleChange);
        formContainer.addEventListener('change', handleLinkChange);
        formContainer.addEventListener('change', handleImageDimensionChange);
        formContainer.addEventListener('change', handleSvgIconChange);
        formContainer.addEventListener('keydown', handleEntryMoveKeydown);
        formContainer.closest('form')?.addEventListener('submit', handleSubmit, true);

        formContainer.dataset.blockBuilderInitialized = 'true';
    }

    function initializeBlockBuilder(root = document) {
        root.querySelectorAll('[data-block-builder-form]').forEach(initializeBlockBuilderForm);
    }

    if (document.readyState === 'loading') {
        document.addEventListener('DOMContentLoaded', () => initializeBlockBuilder(), { once: true });
    } else {
        initializeBlockBuilder();
    }

    if (globalThis.Concrete?.event && typeof globalThis.Concrete.event.bind === 'function') {
        globalThis.Concrete.event.bind('open.block.{{BLOCK_EVENT_NAME}}', () => initializeBlockBuilder());
    }
})();
