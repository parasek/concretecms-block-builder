(function () {
    'use strict';

    const containerStates = new WeakMap();

{{SETUP_CODE}}

    function getEntries(state) {
        return Array.from(state.container.children)
            .filter((element) => element.matches('[data-entry]'));
    }

    function groupFields(entry) {
        const fields = new Map();

        entry.querySelectorAll('[data-entry-field]').forEach((field) => {
            const handle = field.dataset.entryField;
            if (!handle) {
                return;
            }

            if (!fields.has(handle)) {
                fields.set(handle, []);
            }
            fields.get(handle).push(field);
        });

        return fields;
    }

    function normalizeMultipleValue(value) {
        if (Array.isArray(value)) {
            return value.map(String);
        }
        if (typeof value === 'string' && value.includes('|')) {
            return value.split('|');
        }
        if (value === null || typeof value === 'undefined' || value === '') {
            return [];
        }

        return [String(value)];
    }

    function setFieldValue(fields, value) {
        const firstField = fields[0];
        if (!firstField) {
            return;
        }

        if (firstField instanceof HTMLInputElement && firstField.type === 'radio') {
            fields.forEach((field) => {
                field.checked = String(field.value) === String(value ?? '');
            });
            return;
        }

        if (firstField instanceof HTMLInputElement && firstField.type === 'checkbox') {
            const selectedValues = normalizeMultipleValue(value);
            fields.forEach((field) => {
                field.checked = fields.length === 1 && typeof value === 'boolean'
                    ? value
                    : selectedValues.includes(String(field.value));
            });
            return;
        }

        if (firstField instanceof HTMLSelectElement && firstField.multiple) {
            const selectedValues = normalizeMultipleValue(value);
            Array.from(firstField.options).forEach((option) => {
                option.selected = selectedValues.includes(String(option.value));
            });
            return;
        }

        fields.forEach((field) => {
            if (!(field instanceof HTMLInputElement && field.type === 'file') && 'value' in field) {
                field.value = value ?? '';
            }
        });
    }

    function populateEntry(entry, values) {
        if (!values || typeof values !== 'object') {
            return;
        }

        groupFields(entry).forEach((fields, handle) => {
            if (Object.prototype.hasOwnProperty.call(values, handle)) {
                setFieldValue(fields, values[handle]);
            }
        });
    }

    function readFieldValue(fields) {
        const firstField = fields[0];
        if (!firstField) {
            return null;
        }

        if (firstField instanceof HTMLInputElement && firstField.type === 'radio') {
            return fields.find((field) => field.checked)?.value ?? '';
        }
        if (firstField instanceof HTMLInputElement && firstField.type === 'checkbox') {
            if (fields.length === 1) {
                return firstField.checked;
            }
            return fields.filter((field) => field.checked).map((field) => field.value);
        }
        if (firstField instanceof HTMLSelectElement && firstField.multiple) {
            return Array.from(firstField.selectedOptions).map((option) => option.value);
        }
        if (firstField instanceof HTMLInputElement && firstField.type === 'file') {
            return null;
        }

        return 'value' in firstField ? firstField.value : null;
    }

    function readEntry(entry) {
        const values = {};
        groupFields(entry).forEach((fields, handle) => {
            values[handle] = readFieldValue(fields);
        });

        return values;
    }

    function getTitleSourceValue(source) {
        if (source instanceof HTMLSelectElement) {
            return Array.from(source.selectedOptions)
                .map((option) => option.textContent.trim())
                .filter(Boolean)
                .join(', ');
        }
        if (source instanceof HTMLInputElement && ['checkbox', 'radio'].includes(source.type)) {
            return source.checked ? source.value : '';
        }

        return 'value' in source ? String(source.value).trim() : source.textContent.trim();
    }

    function updateEntryTitle(entry, position) {
        const title = Array.from(entry.querySelectorAll('[data-entry-title-source]'))
            .map(getTitleSourceValue)
            .filter(Boolean)
            .join(', ');
        const titleElement = entry.querySelector('[data-entry-title]');
        if (titleElement) {
            titleElement.textContent = `${title} #${position}` || `#${position}`;
        }
    }

    function setEntryExpanded(entry, expanded) {
        const content = entry.querySelector('[data-entry-content]');
        const button = entry.querySelector('[data-entry-action="toggle"]');
        if (!content || !button) {
            return;
        }

        content.hidden = !expanded;
        button.setAttribute('aria-expanded', String(expanded));
        button.setAttribute(
            'aria-label',
            expanded ? button.dataset.collapseLabel : button.dataset.expandLabel,
        );
        button.setAttribute(
            'title',
            expanded ? button.dataset.collapseLabel : button.dataset.expandLabel,
        );

        const icon = button.querySelector('i');
        if (icon) {
            icon.classList.toggle('fa-minus-square', expanded);
            icon.classList.toggle('fa-plus-square', !expanded);
        }
    }

    function updateState(state) {
        const entries = getEntries(state);
        const maximumReached = entries.length >= state.maximum;
        const noEntries = entries.length === 0;

        state.scope.querySelectorAll('[data-entry-count]').forEach((counter) => {
            counter.textContent = String(entries.length);
        });
        state.scope.querySelectorAll('[data-no-entries-message]').forEach((message) => {
            message.hidden = !noEntries;
        });
        state.scope.querySelectorAll(
            '[data-entry-action="add-top"], [data-entry-action="add-bottom"], '
            + '[data-entry-action="duplicate"], [data-entry-action="duplicate-at-end"]',
        ).forEach((button) => {
            button.disabled = maximumReached;
        });
        state.scope.querySelectorAll('[data-entry-action="copy-last"]').forEach((button) => {
            button.disabled = noEntries || maximumReached;
        });
        state.scope.querySelectorAll('[data-entry-action="remove-all"]').forEach((button) => {
            button.disabled = noEntries;
        });

        entries.forEach((entry, index) => {
            updateEntryTitle(entry, index + 1);
        });
    }

    function createEntry(state, values, before = null) {
        if (getEntries(state).length >= state.maximum) {
            return null;
        }

        const index = state.nextIndex;
        state.nextIndex += 1;

        const template = document.createElement('template');
        template.innerHTML = state.template.innerHTML
            .split('__INDEX__')
            .join(String(index))
            .trim();
        const entry = template.content.querySelector('[data-entry]');
        if (!entry) {
            console.error('Block Builder entry template is missing its data-entry element.');
            return null;
        }

        entry.dataset.entryIndex = String(index);
        populateEntry(entry, values);
        state.container.insertBefore(template.content, before);
        initializeRepeatableFields(entry);
        entry.dispatchEvent(new CustomEvent('blockbuilder:entry-added', {bubbles: true}));

        const keepCollapsed = state.scope.querySelector('[data-keep-added-collapsed]')?.checked === true;
        setEntryExpanded(entry, !keepCollapsed);
        updateState(state);

        if (state.scope.querySelector('[data-disable-smooth-scroll]')?.checked !== true) {
            entry.scrollIntoView({behavior: 'smooth', block: 'center'});
        }

        return entry;
    }

    function removeEntry(state, entry) {
        entry.dispatchEvent(new CustomEvent('blockbuilder:entry-before-remove', {bubbles: true}));
        entry.remove();
        updateState(state);
    }

    function confirmAction(button) {
        return !button.dataset.confirm || globalThis.confirm(button.dataset.confirm);
    }

    function getState(element) {
        const scope = element.closest('[data-block-builder-repeatable]');
        const container = scope?.querySelector('[data-block-builder-entries]');

        return container ? containerStates.get(container) : null;
    }

    function handleAction(event) {
        if (!(event.target instanceof Element)) {
            return;
        }

        const button = event.target.closest('[data-entry-action]');
        const state = button ? getState(button) : null;
        if (!button || !state || button.disabled) {
            return;
        }

        event.preventDefault();

        const action = button.dataset.entryAction;
        const entry = button.closest('[data-entry]');
        const entries = getEntries(state);

        if (action === 'add-top') {
            createEntry(state, state.defaults, entries[0] ?? null);
        } else if (action === 'add-bottom') {
            createEntry(state, state.defaults);
        } else if (action === 'copy-last' && entries.length > 0) {
            createEntry(state, readEntry(entries.at(-1)));
        } else if (action === 'duplicate' && entry) {
            createEntry(state, readEntry(entry), entry.nextElementSibling);
        } else if (action === 'duplicate-at-end' && entry) {
            createEntry(state, readEntry(entry));
        } else if (action === 'remove' && entry && confirmAction(button)) {
            removeEntry(state, entry);
        } else if (action === 'remove-all' && confirmAction(button)) {
            entries.forEach((currentEntry) => {
                currentEntry.dispatchEvent(new CustomEvent('blockbuilder:entry-before-remove', {bubbles: true}));
                currentEntry.remove();
            });
            updateState(state);
        } else if (action === 'toggle' && entry) {
            setEntryExpanded(entry, button.getAttribute('aria-expanded') !== 'true');
        } else if (action === 'expand-all') {
            entries.forEach((currentEntry) => setEntryExpanded(currentEntry, true));
        } else if (action === 'collapse-all') {
            entries.forEach((currentEntry) => setEntryExpanded(currentEntry, false));
        }
    }

    function handleTitleChange(event) {
        if (!(event.target instanceof Element) || !event.target.matches('[data-entry-title-source]')) {
            return;
        }

        const entry = event.target.closest('[data-entry]');
        const state = entry ? getState(entry) : null;
        if (state) {
            updateState(state);
        }
    }

    function initializeSortable(state) {
        const jquery = globalThis.jQuery;
        if (typeof jquery !== 'function' || typeof jquery.fn?.sortable !== 'function') {
            console.error('Block Builder repeatable entries require jQuery UI Sortable.');
            return;
        }

        jquery(state.container).sortable({
            axis: 'y',
            cancel: 'input, textarea, select, option',
            cursor: 'move',
            forcePlaceholderSize: true,
            handle: '[data-entry-drag-handle]',
            items: '> [data-entry]',
            placeholder: 'bb-entry-sort-placeholder',
            tolerance: 'pointer',
            start(_event, sortableData) {
                sortableData.item.addClass('bb-entry-dragging');
            },
            stop(_event, sortableData) {
                sortableData.item.removeClass('bb-entry-dragging');
                updateState(state);
            },
        });
    }

    function handleMoveKeydown(event) {
        if (
            !(event.target instanceof Element)
            || !event.target.matches('[data-entry-drag-handle]')
            || !['ArrowUp', 'ArrowDown'].includes(event.key)
        ) {
            return;
        }

        const entry = event.target.closest('[data-entry]');
        const state = entry ? getState(entry) : null;
        if (!entry || !state) {
            return;
        }

        const entries = getEntries(state);
        const position = entries.indexOf(entry);
        if (event.key === 'ArrowUp' && position > 0) {
            event.preventDefault();
            state.container.insertBefore(entry, entries[position - 1]);
        } else if (event.key === 'ArrowDown' && position < entries.length - 1) {
            event.preventDefault();
            state.container.insertBefore(entries[position + 1], entry);
        } else {
            return;
        }

        updateState(state);
        event.target.focus();
    }

    function initializeBasicFields(root) {
{{BASIC_FIELD_INITIALIZERS}}
    }

    function initializeRepeatableFields(entry) {
{{REPEATABLE_FIELD_INITIALIZERS}}
    }

    function parseData(scope) {
        const dataElement = scope.querySelector('script[data-entry-data]');
        if (!dataElement) {
            return {};
        }

        try {
            return JSON.parse(dataElement.textContent || '{}');
        } catch (error) {
            console.error('Block Builder could not parse repeatable entry data.', error);
            return {};
        }
    }

    function initializeContainer(container) {
        if (containerStates.has(container)) {
            return;
        }

        const scope = container.closest('[data-block-builder-repeatable]');
        const template = scope?.querySelector('template[data-entry-template]');
        if (!scope || !template) {
            return;
        }

        const data = parseData(scope);
        const configuredMaximum = Number.parseInt(container.dataset.maxEntries ?? data.maxEntries, 10);
        const usedIndexes = Array.from(container.querySelectorAll(':scope > [data-entry]'))
            .map((entry) => Number.parseInt(entry.dataset.entryIndex, 10))
            .filter(Number.isInteger);
        const state = {
            container,
            defaults: data.defaultValues && typeof data.defaultValues === 'object'
                ? data.defaultValues
                : {},
            maximum: Number.isInteger(configuredMaximum) && configuredMaximum > 0
                ? configuredMaximum
                : Number.POSITIVE_INFINITY,
            nextIndex: usedIndexes.length > 0 ? Math.max(...usedIndexes) + 1 : 0,
            scope,
            template,
        };
        containerStates.set(container, state);

        const existingEntries = getEntries(state);
        if (existingEntries.length > 0) {
            existingEntries.forEach((entry) => initializeRepeatableFields(entry));
        } else if (Array.isArray(data.entries)) {
            data.entries.forEach((values) => createEntry(state, values));
        }
        initializeSortable(state);
        updateState(state);
    }

    function initialize(root = document) {
        initializeBasicFields(root);
        root.querySelectorAll('[data-block-builder-entries]').forEach(initializeContainer);
    }

    document.addEventListener('click', handleAction);
    document.addEventListener('input', handleTitleChange);
    document.addEventListener('change', handleTitleChange);
    document.addEventListener('keydown', handleMoveKeydown);

    if (document.readyState === 'loading') {
        document.addEventListener('DOMContentLoaded', () => initialize(), {once: true});
    } else {
        initialize();
    }

    if (globalThis.Concrete?.event && typeof globalThis.Concrete.event.bind === 'function') {
        globalThis.Concrete.event.bind('open.block.{{BLOCK_EVENT_NAME}}', () => initialize());
    }
}());
