<div class="mb-4">
    <label class="form-label"><?= t({{LABEL_LITERAL}}){{REQUIRED_LABEL_SUFFIX}}; ?></label>
    <?php if (${{ENTITY_IDENTIFIER_VARIABLE}} !== ''): ?>
        <div
            data-block-builder-concrete-selector="express"
            data-selected-value="<?= (int) (${{HANDLE}} ?? 0); ?>"
        >
            <concrete-express-entry-input
                entity-id="<?= h(${{ENTITY_IDENTIFIER_VARIABLE}}); ?>"
                entry-id="<?= (int) (${{HANDLE}} ?? 0); ?>"
                input-name="<?= h($view->field({{HANDLE_LITERAL}})); ?>"
                choose-text="<?= t('Choose entry'); ?>"
            ></concrete-express-entry-input>
        </div>
    <?php else: ?>
        <div class="alert alert-warning mb-0"><?= t('The Express object "%s" could not be found.', {{EXPRESS_HANDLE_LITERAL}}); ?></div>
    <?php endif; ?>{{HELP_TEXT}}
</div>
