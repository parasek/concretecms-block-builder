<?php if (isset(${{HANDLE}}) && ${{HANDLE}} !== ''): ?>
    <?php $selectedValues = explode('|', ${{HANDLE}}); ?>
    <?= t('Selected keys and values'); ?>:<br>
    <?php foreach ($selectedValues as $selectedValue): ?>
        <?= h($selectedValue); ?>: <?= h(${{OPTIONS_VARIABLE}}[$selectedValue] ?? ''); ?><br>
    <?php endforeach; ?>
<?php endif; ?>
