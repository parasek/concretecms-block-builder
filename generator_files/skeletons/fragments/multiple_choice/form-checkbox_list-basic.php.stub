<div class="mb-4">
    <label class="form-label"><?= t({{LABEL_LITERAL}}){{REQUIRED_LABEL_SUFFIX}}; ?></label>
    <?php $selectedValues = isset(${{HANDLE}}) && is_string(${{HANDLE}}) && ${{HANDLE}} !== '' ? explode('|', ${{HANDLE}}) : []; ?>
    <input type="hidden" name="<?= h($view->field({{HANDLE_LITERAL}})); ?>" value="">
    <?php if (!empty(${{OPTIONS_VARIABLE}}) && is_array(${{OPTIONS_VARIABLE}})): ?>
        <?php foreach (${{OPTIONS_VARIABLE}} as $optionKey => $optionLabel): ?>
            <?php $optionIdentifier = $view->field({{HANDLE_LITERAL}}) . '-' . $optionKey; ?>
            <div class="form-check">
                <input
                    class="form-check-input"
                    id="<?= h($optionIdentifier); ?>"
                    name="<?= h($view->field({{HANDLE_LITERAL}})); ?>[]"
                    type="checkbox"
                    value="<?= h((string) $optionKey); ?>"
                    <?= in_array((string) $optionKey, $selectedValues, true) ? 'checked' : ''; ?>
                >
                <label class="form-check-label" for="<?= h($optionIdentifier); ?>">
                    <?= h($optionLabel); ?>
                </label>
            </div>
        <?php endforeach; ?>
    <?php endif; ?>{{HELP_TEXT}}
</div>
