        data-entry-field="{{HANDLE}}"
    >
        <{{COMPONENT_NAME}}
            :{{IDENTIFIER_ATTRIBUTE}}="<?= (int) ($entry[{{HANDLE_LITERAL}}] ?? 0); ?>"
