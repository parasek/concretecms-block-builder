<div class="mb-4">
    <label
        class="form-label"
        for="<?= h($view->field('entry')); ?>-<?= h((string) $entryIndex); ?>-{{HANDLE}}"
    ><?= t({{LABEL_LITERAL}}){{REQUIRED_LABEL_SUFFIX}}; ?></label>
    <textarea
        class="form-control"
        id="<?= h($view->field('entry')); ?>-<?= h((string) $entryIndex); ?>-{{HANDLE}}"{{PLACEHOLDER_ATTRIBUTE}}
        data-block-builder-character-count
        data-character-count-maximum="{{MAXIMUM_LENGTH_VALUE}}"
        name="<?= h($view->field('entry')); ?>[<?= h((string) $entryIndex); ?>][{{HANDLE}}]"
        data-block-builder-autosize
        data-entry-field="{{HANDLE}}"{{TITLE_SOURCE_ATTRIBUTE}}{{HEIGHT_STYLE_ATTRIBUTE}}{{MAXIMUM_LENGTH_ATTRIBUTE}}
    ><?= h(isset($entry[{{HANDLE_LITERAL}}]) && is_scalar($entry[{{HANDLE_LITERAL}}]) ? (string) $entry[{{HANDLE_LITERAL}}] : ''); ?></textarea>
    <div class="form-text text-end" data-block-builder-character-counter><span data-character-count-current>0</span>{{COUNTER_MAXIMUM}} <?= t('characters'); ?></div>{{HELP_TEXT}}
</div>
