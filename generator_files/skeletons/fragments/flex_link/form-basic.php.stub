<?php $blockBuilderLink = isset(${{HANDLE}}) && is_array(${{HANDLE}}) ? ${{HANDLE}} : []; ?>
<div class="bb-link-field mb-4" data-block-builder-link>
    <label
        class="form-label"
        for="<?= h($view->field({{HANDLE_LITERAL}})); ?>-link-type"
    ><?= t({{LABEL_LITERAL}}){{REQUIRED_LABEL_SUFFIX}}; ?></label>
    <div class="row g-3 align-items-end">
        <div class="col-lg-6">
            <select
                class="form-select"
                id="<?= h($view->field({{HANDLE_LITERAL}})); ?>-link-type"
                name="<?= h($view->field({{HANDLE_LITERAL}})); ?>[link_type]"
                data-link-type
            >
                <option value="">----</option>
                <option value="link_from_sitemap" <?= ($blockBuilderLink['link_type'] ?? '') === 'link_from_sitemap' ? 'selected' : ''; ?>>
                    <?= t({{SITEMAP_LABEL_LITERAL}}); ?>
                </option>
                <option value="link_from_file_manager" <?= ($blockBuilderLink['link_type'] ?? '') === 'link_from_file_manager' ? 'selected' : ''; ?>>
                    <?= t({{FILE_LABEL_LITERAL}}); ?>
                </option>
                <option value="external_link" <?= ($blockBuilderLink['link_type'] ?? '') === 'external_link' ? 'selected' : ''; ?>>
                    <?= t({{EXTERNAL_LABEL_LITERAL}}); ?>
                </option>
            </select>
        </div>
        <div class="col-lg-6">
            <button
                class="btn btn-secondary"
                type="button"
                data-link-toggle-additional
                data-show-label="<?= t({{SHOW_ADDITIONAL_LABEL_LITERAL}}); ?>"
                data-hide-label="<?= t({{HIDE_ADDITIONAL_LABEL_LITERAL}}); ?>"
                <?= empty($blockBuilderLink['link_type']) ? 'hidden' : ''; ?>
            >
                <i class="fas fa-caret-right" aria-hidden="true"></i>
                <span data-link-toggle-label>
                    <?= !empty($blockBuilderLink['show_additional_fields'])
                        ? t({{HIDE_ADDITIONAL_LABEL_LITERAL}})
                        : t({{SHOW_ADDITIONAL_LABEL_LITERAL}}); ?>
                </span>
            </button>
            <input
                name="<?= h($view->field({{HANDLE_LITERAL}})); ?>[show_additional_fields]"
                type="hidden"
                value="<?= !empty($blockBuilderLink['show_additional_fields']) ? '1' : '0'; ?>"
                data-link-additional-value
            >
        </div>
    </div>

    <div
        class="mt-3"
        data-link-type-panel="link_from_sitemap"
        <?= ($blockBuilderLink['link_type'] ?? '') === 'link_from_sitemap' ? '' : 'hidden'; ?>
    >
        <div
            data-block-builder-concrete-selector="page"
            data-selected-value="<?= (int) ($blockBuilderLink['link_from_sitemap'] ?? 0); ?>"
        >
            <concrete-page-input
                :page-id="<?= (int) ($blockBuilderLink['link_from_sitemap'] ?? 0); ?>"
                input-name="<?= h($view->field({{HANDLE_LITERAL}})); ?>[link_from_sitemap]"
                choose-text="<?= t('Choose Page'); ?>"
            ></concrete-page-input>
        </div>
    </div>

    <div
        class="mt-3"
        data-link-type-panel="link_from_file_manager"
        <?= ($blockBuilderLink['link_type'] ?? '') === 'link_from_file_manager' ? '' : 'hidden'; ?>
    >
        <div
            data-block-builder-concrete-selector="file"
            data-selected-value="<?= (int) ($blockBuilderLink['link_from_file_manager'] ?? 0); ?>"
        >
            <concrete-file-input
                :file-id="<?= (int) ($blockBuilderLink['link_from_file_manager'] ?? 0); ?>"
                input-name="<?= h($view->field({{HANDLE_LITERAL}})); ?>[link_from_file_manager]"
                choose-text="<?= t('Choose File'); ?>"
            ></concrete-file-input>
        </div>
    </div>

    <div
        class="row g-3 mt-0"
        data-link-type-panel="external_link"
        <?= ($blockBuilderLink['link_type'] ?? '') === 'external_link' ? '' : 'hidden'; ?>
    >
        <div class="col-lg-4">
            <select
                class="form-select"
                name="<?= h($view->field({{HANDLE_LITERAL}})); ?>[protocol]"
                data-link-protocol
            >
                <?php foreach (['https://', 'http://', 'BASE_URL', 'CURRENT_PAGE', 'other'] as $protocol): ?>
                    <option value="<?= h($protocol); ?>" <?= ($blockBuilderLink['protocol'] ?? 'https://') === $protocol ? 'selected' : ''; ?>>
                        <?= h($protocol === 'other' ? '----' : $protocol); ?>
                    </option>
                <?php endforeach; ?>
            </select>
        </div>
        <div class="col-lg-8">
            <input
                class="form-control"
                name="<?= h($view->field({{HANDLE_LITERAL}})); ?>[external_link]"
                type="text"
                value="<?= h($blockBuilderLink['external_link'] ?? ''); ?>"
                maxlength="255"
                data-link-external-url
            >
        </div>
    </div>

    <div
        class="row g-3 mt-0"
        data-link-additional-fields
        <?= !empty($blockBuilderLink['link_type']) && !empty($blockBuilderLink['show_additional_fields']) ? '' : 'hidden'; ?>
    >
        <div class="col-12">
            <label class="form-label" for="<?= h($view->field({{HANDLE_LITERAL}})); ?>-ending">
                <?= t({{ENDING_LABEL_LITERAL}}); ?>
            </label>
            <input
                class="form-control"
                id="<?= h($view->field({{HANDLE_LITERAL}})); ?>-ending"
                name="<?= h($view->field({{HANDLE_LITERAL}})); ?>[ending]"
                type="text"
                value="<?= h($blockBuilderLink['ending'] ?? ''); ?>"
                maxlength="255"
            >
            <div class="form-text"><?= t({{ENDING_HELP_LITERAL}}); ?></div>
        </div>
        <div class="col-12">
            <label class="form-label" for="<?= h($view->field({{HANDLE_LITERAL}})); ?>-text">
                <?= t({{TEXT_LABEL_LITERAL}}); ?>
            </label>
            <textarea
                class="form-control"
                id="<?= h($view->field({{HANDLE_LITERAL}})); ?>-text"
                name="<?= h($view->field({{HANDLE_LITERAL}})); ?>[text]"
                maxlength="255"
            ><?= h($blockBuilderLink['text'] ?? ''); ?></textarea>
        </div>
        <div class="col-12">
            <label class="form-label" for="<?= h($view->field({{HANDLE_LITERAL}})); ?>-title">
                <?= t({{TITLE_LABEL_LITERAL}}); ?>
            </label>
            <input
                class="form-control"
                id="<?= h($view->field({{HANDLE_LITERAL}})); ?>-title"
                name="<?= h($view->field({{HANDLE_LITERAL}})); ?>[title]"
                type="text"
                value="<?= h($blockBuilderLink['title'] ?? ''); ?>"
                maxlength="255"
            >
        </div>
        <div class="col-lg-6">
            <label class="form-label" for="<?= h($view->field({{HANDLE_LITERAL}})); ?>-new-window">
                <?= t({{NEW_WINDOW_LABEL_LITERAL}}); ?>
            </label>
            <select
                class="form-select"
                id="<?= h($view->field({{HANDLE_LITERAL}})); ?>-new-window"
                name="<?= h($view->field({{HANDLE_LITERAL}})); ?>[new_window]"
            >
                <option value="0" <?= empty($blockBuilderLink['new_window']) ? 'selected' : ''; ?>><?= t({{NO_LABEL_LITERAL}}); ?></option>
                <option value="1" <?= !empty($blockBuilderLink['new_window']) ? 'selected' : ''; ?>><?= t({{YES_LABEL_LITERAL}}); ?></option>
            </select>
        </div>
        <div class="col-lg-6">
            <label class="form-label" for="<?= h($view->field({{HANDLE_LITERAL}})); ?>-no-follow">
                <?= t({{NO_FOLLOW_LABEL_LITERAL}}); ?>
            </label>
            <select
                class="form-select"
                id="<?= h($view->field({{HANDLE_LITERAL}})); ?>-no-follow"
                name="<?= h($view->field({{HANDLE_LITERAL}})); ?>[no_follow]"
            >
                <option value="0" <?= empty($blockBuilderLink['no_follow']) ? 'selected' : ''; ?>><?= t({{NO_LABEL_LITERAL}}); ?></option>
                <option value="1" <?= !empty($blockBuilderLink['no_follow']) ? 'selected' : ''; ?>><?= t({{YES_LABEL_LITERAL}}); ?></option>
            </select>
        </div>
    </div>{{HELP_TEXT}}
</div>
