<div class="mb-4{{HIGHLIGHT_CLASS}}">
    <label class="form-label"><?= t({{LABEL_LITERAL}}){{REQUIRED_LABEL_SUFFIX}}; ?></label>
    <div class="d-flex flex-wrap align-items-center gap-4 mb-4">
        <div
            class="flex-grow-1"
            data-block-builder-concrete-selector="file"
            data-selected-value="<?= (int) (${{HANDLE}} ?? 0); ?>"
        >
            <concrete-file-input
                :filters='<?= json_encode([["field" => "type", "type" => \Concrete\Core\File\Type\Type::T_IMAGE]]); ?>'
                :file-id="<?= (int) (${{HANDLE}} ?? 0); ?>"
                input-name="<?= h($view->field({{HANDLE_LITERAL}})); ?>"
                choose-text="<?= t('Choose image'); ?>"
            ></concrete-file-input>
        </div>{{ADDITIONAL_FIELDS}}
    </div>{{HELP_TEXT}}
</div>
