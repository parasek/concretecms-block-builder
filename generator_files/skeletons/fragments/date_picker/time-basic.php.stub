        <div class="col-auto">
            <select
                class="form-select"
                id="<?= h($view->field({{HOUR_LITERAL}})); ?>"
                name="<?= h($view->field({{HOUR_LITERAL}})); ?>"
                aria-label="<?= t('Hour'); ?>"
            >
                <?php for ($datePickerHour = 0; $datePickerHour < 24; ++$datePickerHour): ?>
                    <option
                        value="<?= $datePickerHour; ?>"
                        <?= (int) (${{HANDLE}}_hour ?? 0) === $datePickerHour ? 'selected' : ''; ?>
                    ><?= sprintf('%02d', $datePickerHour); ?></option>
                <?php endfor; ?>
            </select>
        </div>
        <div class="col-auto">:</div>
        <div class="col-auto">
            <select
                class="form-select"
                id="<?= h($view->field({{MINUTE_LITERAL}})); ?>"
                name="<?= h($view->field({{MINUTE_LITERAL}})); ?>"
                aria-label="<?= t('Minute'); ?>"
            >
                <?php for ($datePickerMinute = 0; $datePickerMinute < 60; $datePickerMinute += {{MINUTE_INTERVAL}}): ?>
                    <option
                        value="<?= $datePickerMinute; ?>"
                        <?= (int) (${{HANDLE}}_minute ?? 0) === $datePickerMinute ? 'selected' : ''; ?>
                    ><?= sprintf('%02d', $datePickerMinute); ?></option>
                <?php endfor; ?>
            </select>
        </div>
