#: src/BlockBuilder/Block/Request/BlockFormFieldLabelProvider.php:21
#: src/BlockBuilder/Block/Validation/Validator/Block/BlockNumericValuesValidator.php:30
msgid "Cache block output lifetime"
msgstr "Durée de mise en cache de la sortie du bloc"

#: elements/navigation_tab_content/block_settings.php:136
msgid ""
"Number of seconds before the cached output is refreshed. Use 0 for no time "
"limit."
msgstr ""
"Nombre de secondes avant l’actualisation de la sortie mise en cache. "
"Utilisez 0 pour ne définir aucune limite de temps."

#: elements/navigation_tab_content/block_settings.php:140
#: src/BlockBuilder/Block/Request/BlockFormFieldLabelProvider.php:22
msgid "Cache block output for POST requests"
msgstr "Mettre en cache la sortie du bloc pour les requêtes POST"

#: elements/navigation_tab_content/block_settings.php:143
msgid ""
"Allow cached output for HTTP POST requests. Disable this for blocks that "
"must display POST-specific responses or error messages."
msgstr ""
"Autoriser la sortie mise en cache pour les requêtes HTTP POST. Désactivez "
"cette option pour les blocs qui doivent afficher des réponses ou des "
"messages d’erreur propres aux requêtes POST."

#: elements/navigation_tab_content/block_settings.php:147
#: src/BlockBuilder/Block/Request/BlockFormFieldLabelProvider.php:23
msgid "Cache block output in edit mode"
msgstr "Mettre en cache la sortie du bloc en mode édition"

#: elements/navigation_tab_content/block_settings.php:150
msgid ""
"Allow cached output while the page is in edit mode. Disable this if the "
"block displays edit-mode-specific content or controls."
msgstr ""
"Autoriser la sortie mise en cache lorsque la page est en mode édition. "
"Désactivez cette option si le bloc affiche du contenu ou des commandes "
"propres au mode édition."

#: elements/navigation_tab_content/block_settings.php:154
#: src/BlockBuilder/Block/Request/BlockFormFieldLabelProvider.php:24
msgid "Cache block output for registered users"
msgstr "Mettre en cache la sortie du bloc pour les utilisateurs inscrits"

#: elements/navigation_tab_content/block_settings.php:157
